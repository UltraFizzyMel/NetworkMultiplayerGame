    - target: {fileID: 7083202093698405450, guid: eb6f4148845d7e745989350dd6c8fdbd, type: 3}
      propertyPath: m_text
      value: "The sea will continue forcing its \nway inside the hull.\nFill the
        bucket from the floor, then give it back to the sea.\n\nA full bucket cannot
        collect more water."
      objectReference: {fileID: 0}
