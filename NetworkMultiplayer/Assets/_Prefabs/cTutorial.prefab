  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Two sailors.\r\nOne dying engine.\r\nA lighthouse somewhere beyond the
    fog.\r\n\r\nKeep the boat moving. Keep the hull dry.\r\nAnd whatever waits in
    the mist\u2026 \nDo not let it aboard.\r\n\r\nOne player works the deck.\r\nOne
    watches the cabin.\r\nSurvival depends on both of you.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d389b38c7d0a6ff43ab7b53d96ca3c5a, type: 2}
