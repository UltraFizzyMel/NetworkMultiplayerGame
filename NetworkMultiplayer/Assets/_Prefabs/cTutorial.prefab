  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The engine must be kept running if the ship is to reach the lighthouse.\r\nHold
    [E] at the generator to refuel it.\n\r\nIf the engine dies, the boat will stop
    drifting forward\u2026 leaving the vessel stranded in open water with the fog
    closing in.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d389b38c7d0a6ff43ab7b53d96ca3c5a, type: 2}
