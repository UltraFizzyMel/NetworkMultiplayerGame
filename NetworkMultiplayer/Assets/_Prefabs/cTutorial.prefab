  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "One crewmate must guide the vessel through the fog.\r\nUse the wheel to
    steer:\r\n\u2022 Hold [A] to turn left\r\n\u2022 Hold [D] to turn right\r\n\u2022
    Press [Esc] to leave the wheel\r\nThe sea is rough, and the boat does not turn
    quickly.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d389b38c7d0a6ff43ab7b53d96ca3c5a, type: 2}
